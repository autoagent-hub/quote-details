SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# External Supabase project
EXTERNAL_SUPABASE_URL=
EXTERNAL_SUPABASE_SERVICE_ROLE_KEY=

# App & Deployment
PUBLIC_APP_URL=
NITRO_PRESET=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Email (Primary — Recommended for 100% reliable inbox delivery to Gmail)
# How to get Google App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an App name (e.g. "Detailr") and copy the 16-character password into GMAIL_APP_PASSWORD.
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM_NAME="Detailr"
EMAIL_REPLY_TO="support@detailr.online"

# Resend Email (Fallback if Google is not configured)
EMAIL_FROM=
RESEND_API_KEY=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Flutterwave Payments & Webhook
# How to get these from your Flutterwave Dashboard:
# 1. Log in to your Flutterwave Dashboard (https://dashboard.flutterwave.com).
# 2. Go to Settings > API Keys.
# 3. Copy your Public Key (FLWPUBK_...) -> FLUTTERWAVE_PUBLIC_KEY
# 4. Copy your Secret Key (FLWSECK_...) -> FLUTTERWAVE_SECRET_KEY
# 5. Copy your Encryption Key -> FLUTTERWAVE_ENCRYPTION_KEY
# 6. Go to Settings > Webhooks, set your webhook URL to: https://yourdomain.com/api/public/flutterwave-webhook
#    and copy the Secret Hash -> FLUTTERWAVE_WEBHOOK_SECRET
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
